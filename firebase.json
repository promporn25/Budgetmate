{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "budgetmate-app-a94da",
          "appId": "1:636277696280:android:cc79a1007baa596ba1206d",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "budgetmate-app-a94da",
          "appId": "1:636277696280:ios:15564d6417db857fa1206d",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "budgetmate-app-a94da",
          "appId": "1:636277696280:ios:5c02afbb198561fca1206d",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "budgetmate-app-a94da",
          "configurations": {
            "android": "1:636277696280:android:cc79a1007baa596ba1206d",
            "ios": "1:636277696280:ios:15564d6417db857fa1206d"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "database": "default"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "receipts"
    }
  ],
  "hosting": {
    "site": "budgetmate-app-a94da",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/reset_password.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/reset_password.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/reset_password.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}

{
  "minCodePoints": 6,
  "maxUtf16Units": 128,
  "blockedPasswords": [
    "123456789012345",
    "1234567890123456",
    "12345678901234567890",
    "passwordpassword",
    "password123456789",
    "password12345678",
    "qwertyuiopasdfgh",
    "qwertyuiopasdfghjkl",
    "qwerty1234567890",
    "aaaaaaaaaaaaaaa",
    "111111111111111",
    "000000000000000",
    "budgetmate123456",
    "budgetmatepassword",
    "budgetmatebudgetmate"
  ],
  "requiredPatterns": {
    "lowercase": "[a-z]",
    "uppercase": "[A-Z]",
    "digit": "[0-9]",
    "symbol": "[\\x21-\\x2F\\x3A-\\x40\\x5B-\\x60\\x7B-\\x7E]"
  }
}
